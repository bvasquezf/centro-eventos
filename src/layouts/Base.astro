---
import { withBase, withoutBase } from '../lib/paths';
import '../styles/global.css';
import { site, navigation } from '../content/site';
import Consent from '../components/containers/Consent';
import MobileNavigation from '../components/ui/MobileNavigation';
interface Props { title: string; privatePage?: boolean }
const { title, privatePage = false } = Astro.props;
const brandName = site.name.replace(/^Centro de Eventos\s*/, '');
---
<!doctype html>
<html lang="es"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>{title} · {site.name}</title><meta name="description" content="Conoce los espacios y envía una solicitud de cotización o visita. Fechas sujetas a confirmación." />{privatePage && <meta name="robots" content="noindex,nofollow" />}<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} /><link rel="preload" href={withBase('/fonts/playfair-latin.woff2')} as="font" type="font/woff2" crossorigin /><link rel="preload" href={withBase('/fonts/inter-latin.woff2')} as="font" type="font/woff2" crossorigin /></head>
<body class:list={[privatePage && 'private-page']}><a class="skip" href="#contenido">Saltar al contenido</a><header class="site-header"><div class="container header-inner"><a class="brand" href={withBase('/')} aria-label={`${site.name} — Inicio`}><svg class="brand-mark" viewBox="0 0 46 54" fill="none" aria-hidden="true"><path d="M4 50V23a19 19 0 0 1 38 0v27M12 50V23a11 11 0 0 1 22 0v27M23 4v46M0 50h46" stroke="currentColor" stroke-width="1.2" /></svg><span>Centro de Eventos<span class="brand-name">{brandName}</span></span></a><nav class="desktop-nav" aria-label="Navegación principal">{navigation.map(([href,label]) => <a href={withBase(href)} aria-current={withoutBase(Astro.url.pathname) === href ? 'page' : undefined}>{label}</a>)}</nav><a class="header-cta" href={withBase('/contacto/#formulario')}>Hablemos de tu evento <span aria-hidden="true">↗</span></a><MobileNavigation currentPath={withoutBase(Astro.url.pathname)} client:load /></div></header><main id="contenido" class="container"><slot /></main><footer class="site-footer"><div class="container"><div class="footer-main"><div><a class="footer-brand" href={withBase('/')}>Centro de Eventos<br /><em>{brandName}</em></a><p class="footer-description">Un lugar para reunirnos,<br />celebrar y compartir.</p></div><div><h2 class="footer-title">Encuéntranos</h2><p>{site.address}</p><p>{site.email}<br />{site.phone}</p></div><div><h2 class="footer-title">Explora</h2><nav aria-label="Enlaces del pie de página">{navigation.slice(1).map(([href,label]) => <a href={withBase(href)}>{label}</a>)}</nav></div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} {site.name}</span><div><a href={withBase('/contacto/#privacidad')}>Privacidad</a><a href={withBase('/panel/')}>Acceso encargados</a></div></div>{!privatePage && <Consent client:load />}</div></footer></body></html>
