---
import { withBase, withoutBase } from '../lib/paths';
import '../styles/global.css';
import { site, navigation } from '../content/site';
import Consent from '../components/containers/Consent';
import MobileNavigation from '../components/ui/MobileNavigation';
interface Props { title: string; privatePage?: boolean; immersive?: boolean }
const { title, privatePage = false, immersive = false } = Astro.props;
const brandName = site.name.replace(/^Centro de Eventos\s*/, '');
---
<!doctype html>
<html lang="es"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>{title} · {site.name}</title><meta name="description" content="Fiestas de empresa y encuentros de equipos. Explora los espacios y solicita una cotización o visita. Fechas sujetas a confirmación." />{privatePage && <meta name="robots" content="noindex,nofollow" />}<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} /><link rel="preload" href={withBase('/fonts/manrope-variable.ttf')} as="font" type="font/ttf" crossorigin /><link rel="preload" href={withBase('/fonts/inter-latin.woff2')} as="font" type="font/woff2" crossorigin /></head>
<body class:list={[privatePage && 'private-page']}><a class="skip" href="#contenido">Saltar al contenido</a><header class="site-header"><div class="container header-inner"><a class="brand" href={withBase('/')} aria-label={`${site.name} — Inicio`}><svg class="brand-mark" viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="M5 9h10v30H5zM19 17h10v22H19zM33 4h10v35H33z" fill="currentColor" stroke="none" /></svg><span>Centro de Eventos<span class="brand-name">{brandName}</span></span></a><nav class="desktop-nav" aria-label="Navegación principal">{navigation.map(([href,label]) => <a href={withBase(href)} aria-current={withoutBase(Astro.url.pathname) === href ? 'page' : undefined}>{label}</a>)}</nav><a class="header-cta" href={withBase('/contacto/#formulario')}>Cotizar evento <span aria-hidden="true">↗</span></a><MobileNavigation currentPath={withoutBase(Astro.url.pathname)} client:load /></div></header><main id="contenido" class:list={[immersive ? 'immersive-main' : 'container']}><slot /></main><footer class="site-footer"><div class="container"><div class="footer-main"><div><a class="footer-brand" href={withBase('/')}>Centro de Eventos<br /><span>{brandName}</span></a><p class="footer-description">Fuera de la rutina.<br />Juntos para celebrar.</p></div><div><h2 class="footer-title">Encuéntranos</h2><p>{site.address}</p><p>{site.email}<br />{site.phone}</p></div><div><h2 class="footer-title">Explora</h2><nav aria-label="Enlaces del pie de página">{navigation.slice(1).map(([href,label]) => <a href={withBase(href)}>{label}</a>)}</nav></div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} {site.name}</span><div><a href={withBase('/contacto/#privacidad')}>Privacidad</a><a href={withBase('/panel/')}>Acceso encargados</a></div></div>{!privatePage && <Consent client:load />}</div></footer></body></html>
