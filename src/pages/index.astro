---
import { withBase } from '../lib/paths';
import Base from '../layouts/Base.astro';
import { spaces } from '../content/site';
import { illustrativePhotos, serviceReferences, galleryPhotos } from '../content/design';
import PhotoFrame from '../components/design/PhotoFrame.astro';
import VisitCta from '../components/design/VisitCta.astro';
---
<Base title="Inicio"><section class="home-hero"><div class="hero-heading"><div><p class="eyebrow"><span class="tiny-line"></span> Celebrar · Conectar · Compartir</p><h1>El espacio para tu <em>próximo gran evento.</em></h1></div><div class="hero-intro"><p>Las mejores historias empiezan cuando nos encontramos. Cuéntanos la tuya y conversemos sobre el lugar para hacerla realidad.</p><div class="actions"><a class="button" href={withBase('/contacto/#formulario')}>Solicitar cotización <span aria-hidden="true">↗</span></a><a class="text-link" href={withBase('/espacios/')}>Conocer el recinto <span aria-hidden="true">→</span></a></div></div></div><PhotoFrame photo={illustrativePhotos[0]} eager class="hero-photo" sizes="(min-width: 1440px) 1280px, 100vw" /><div class="hero-bottom"><span>Fiestas y celebraciones</span><span class="small">Encuentros corporativos</span><a href="#espacios" class="text-link small">Descubre más <span aria-hidden="true">↓</span></a></div></section>
<section class="editorial-intro section"><p class="eyebrow">El lugar es solo el comienzo</p><div><h2>Un encuentro merece <em>su propio espacio.</em></h2><p>Para una celebración personal o el próximo encuentro de tu empresa, el primer paso es el mismo: conocer tu idea. Nuestro equipo revisa cada solicitud y responde de forma personal.</p></div></section>
<section class="section" id="espacios"><div class="section-heading"><div><p class="eyebrow">Espacios e instalaciones</p><h2>Imagina las posibilidades.</h2></div><a class="text-link" href={withBase('/espacios/')}>Explorar el recinto <span aria-hidden="true">↗</span></a></div><div class="space-preview-grid">{spaces.slice(0,3).map((space,index) => <article class="space-preview"><a href={withBase(`/espacios/#${space.id}`)} aria-label={`Conocer espacio ${index + 1}`}><PhotoFrame photo={illustrativePhotos[[0,2,1][index]]} sizes="(min-width: 900px) 32vw, 100vw" /></a><div class="space-preview-heading"><h3>Espacio 0{index + 1}</h3><span aria-hidden="true">↗</span></div><p class="muted small">Nombre, capacidad y características por confirmar.</p></article>)}</div></section>
<section class="service-section section"><div><p class="eyebrow">Pensado alrededor de tu idea</p><h2>Lo que necesitas, <em>lo conversamos.</em></h2><p class="muted">Cada evento tiene sus propias necesidades. Revisemos juntos los espacios, el equipamiento y las condiciones.</p><a class="text-link" href={withBase('/eventos/')}>Eventos y servicios <span aria-hidden="true">↗</span></a></div><div class="service-list">{serviceReferences.map(service => <article><span class="eyebrow">{service.number}</span><div><h3>{service.title}</h3><p>{service.description}</p><span class="pending-tag">{service.pending}</span></div></article>)}</div></section>
<section class="section home-gallery"><div class="section-heading"><div><p class="eyebrow">Inspiración para encontrarnos</p><h2>Los detalles también cuentan.</h2></div><a class="text-link" href={withBase('/galeria/')}>Ver galería <span aria-hidden="true">↗</span></a></div><div class="gallery-preview">{[galleryPhotos[1] ?? galleryPhotos[0], galleryPhotos[2] ?? galleryPhotos[0]].filter(Boolean).map(photo => <a href={withBase('/galeria/')} aria-label="Explorar fotografías de referencia"><PhotoFrame photo={photo} /></a>)}</div></section><VisitCta /></Base>
