---
import { withBase } from '../lib/paths';
import Base from '../layouts/Base.astro';
import { spaces } from '../content/site';
import { illustrativePhotos, serviceReferences } from '../content/design';
import PhotoFrame from '../components/design/PhotoFrame.astro';
import VisitCta from '../components/design/VisitCta.astro';
import '../styles/experience.css';
const chapters = [
  { label: 'Celebrar', title: 'El año termina. La noche empieza.', description: 'Fiestas de fin de año y aniversarios para celebrar lo que han logrado juntos.', photo: illustrativePhotos[0] },
  { label: 'Conectar', title: 'Las mejores ideas empiezan entre personas.', description: 'Encuentros de empresa para conversar, compartir y mirar lo que viene.', photo: illustrativePhotos[1] },
  { label: 'Reunirse', title: 'Un cambio de lugar. Otra perspectiva.', description: 'Jornadas de equipo fuera de la oficina. Cuéntanos el formato y revisemos las posibilidades.', photo: illustrativePhotos[2] },
];
const manifesto = 'Un año de trabajo. Un logro compartido. Un equipo que merece volver a encontrarse. Hay momentos que se viven mejor fuera de la rutina.';
---
<Base title="Fiestas de empresa y eventos corporativos" immersive>
  <section class="experience-hero" data-scroll-scene="hero" aria-labelledby="experience-title">
    <div class="hero-stage">
      <div class="experience-intro">
        <p class="experience-kicker">Eventos de empresa</p>
        <h1 id="experience-title"><span>Fuera de la rutina.</span><span>Dentro del momento.</span></h1>
        <p class="experience-subtitle">Un equipo. Mucho que celebrar.</p>
        <div class="actions"><a class="button" href={withBase('/contacto/#formulario')}>Cotizar mi evento</a><a class="experience-link" href="#experiencia">Explorar la experiencia <span aria-hidden="true">⌄</span></a></div>
      </div>
      <div class="experience-visual"><PhotoFrame photo={illustrativePhotos[0]} eager caption={false} sizes="100vw" /></div>
      <div class="hero-arrival"><h2>Ese momento.<br />Con tu equipo.</h2><p>Fiestas de fin de año, aniversarios<br />y encuentros que rompen la rutina.</p><a class="button light" href={withBase('/eventos/')}>Encuentra tu ocasión</a></div>
      <div class="experience-footnote"><span>Fotografía ilustrativa. No corresponde al recinto.</span><span class="scroll-invitation">Desliza para descubrir <span aria-hidden="true">↓</span></span></div>
    </div>
  </section>

  <section class="manifesto experience-container" aria-label="Un encuentro para tu equipo" data-manifesto>
    <p class="manifesto-copy"><span class="sr-only">{manifesto}</span><span aria-hidden="true">{manifesto.split(' ').map((word,index) => <span class="manifesto-word" style={`--word-index:${index}`}>{word}{' '}</span>)}</span></p>
    <p class="manifesto-caption">Tú pones el motivo. Empecemos a imaginar el encuentro.</p>
  </section>

  <section id="experiencia" class="experience-heading experience-container"><p class="experience-kicker">Tu empresa, a su manera</p><h2>No todos los encuentros<br />se viven igual.</h2><p>Una gran celebración o una conversación pendiente.<br />Explora lo que tienes en mente para tu equipo.</p></section>
  <section class="occasion-story" data-scroll-scene="occasions" aria-label="Explora tres formas de encontrarse">
    <div class="occasion-stage">
      <div class="occasion-slides">{chapters.map((chapter,index) => <article class="occasion-slide" data-chapter={index} aria-labelledby={`occasion-title-${index}`}>
        <PhotoFrame photo={chapter.photo} caption={false} sizes="100vw" />
        <div class="occasion-copy"><p class="experience-kicker">{chapter.label}</p><h3 id={`occasion-title-${index}`}>{chapter.title}</h3><p>{chapter.description}</p><a class="experience-link" href={withBase('/contacto/#formulario')}>Hablemos de tu evento <span aria-hidden="true">↗</span></a></div>
      </article>)}</div>
      <div class="occasion-navigation" role="group" aria-label="Elegir ambiente">{chapters.map((chapter,index) => <button type="button" class="occasion-choice" data-scene-target={index} aria-pressed={index===0}><span class="choice-dot" aria-hidden="true"></span>{chapter.label}</button>)}</div>
      <p class="occasion-disclaimer">Imágenes de referencia. No corresponden al recinto.</p>
    </div>
  </section>

  <section class="spaces-experience experience-container" id="espacios"><div class="experience-section-heading"><div><p class="experience-kicker">El siguiente paso es conocerlo</p><h2>Hazle espacio<br />a tu próximo evento.</h2></div><a class="experience-link" href={withBase('/espacios/')}>Explorar el recinto <span aria-hidden="true">↗</span></a></div>
    <div class="experience-spaces">{spaces.slice(0,3).map((space,index) => <article class="experience-space"><a class="experience-space-image" href={withBase(`/espacios/#${space.id}`)} aria-label={`Conocer espacio ${index+1}`}><PhotoFrame photo={illustrativePhotos[[1,2,0][index]]} caption={false} sizes="(min-width: 900px) 33vw, 90vw" /><span class="space-open" aria-hidden="true">+</span></a><div><h3>Espacio {index+1}</h3><p>Nombre, capacidad e instalaciones por confirmar.</p></div></article>)}</div>
  </section>

  <section class="planning-experience experience-container"><div><p class="experience-kicker">Del primer mensaje al encuentro</p><h2>Una buena idea.<br />Y una conversación.</h2><p class="planning-description">No necesitas tener todo resuelto. Comparte lo que imaginas y revisaremos contigo los detalles.</p><a class="button" href={withBase('/contacto/#formulario')}>Empezar mi solicitud</a></div><div class="planning-details">{serviceReferences.map(service => <article><h3>{service.title}</h3><p>{service.description}</p><span>{service.pending}</span></article>)}</div></section>
  <div class="experience-container"><VisitCta /></div>
</Base>
<script>
  import '../scripts/experience';
</script>
