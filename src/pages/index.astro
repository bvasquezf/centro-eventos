---
import { withBase } from '../lib/paths';
import Base from '../layouts/Base.astro';
import { spaces } from '../content/site';
import { illustrativePhotos, serviceReferences, galleryPhotos } from '../content/design';
import PhotoFrame from '../components/design/PhotoFrame.astro';
import VisitCta from '../components/design/VisitCta.astro';
const occasions = ['Fiestas de fin de año', 'Aniversarios de empresa', 'Encuentros de equipos'];
---
<Base title="Fiestas de empresa y eventos corporativos">
  <section class="home-hero" aria-labelledby="hero-title">
    <PhotoFrame photo={illustrativePhotos[0]} eager class="hero-photo" sizes="(min-width: 900px) 75vw, 100vw" caption={false} />
    <div class="hero-copy">
      <p class="eyebrow">Fiestas de empresa & encuentros corporativos</p>
      <h1 id="hero-title">Tu equipo merece una gran celebración.</h1>
      <p class="hero-description">Hay momentos para trabajar juntos. Y otros para celebrar todo lo que han logrado. Hagamos espacio para esos momentos.</p>
      <div class="actions"><a class="button" href={withBase('/contacto/#formulario')}>Cotizar mi evento <span aria-hidden="true">↗</span></a><a class="hero-secondary" href={withBase('/espacios/')}>Conocer los espacios</a></div>
    </div>
    <span class="hero-image-note">Imagen de referencia. No corresponde al recinto.</span>
  </section>
  <div class="occasion-strip" aria-label="Ideas para tu evento">{occasions.map(occasion => <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg>{occasion}</span>)}</div>

  <section class="editorial-intro section">
    <p class="eyebrow">Un buen motivo para encontrarse</p>
    <div><h2>Fuera de la oficina.<br />Más cerca como equipo.</h2><p>Una fiesta para cerrar el año. Un aniversario para reconocer el camino recorrido. Un encuentro para volver a conectar. Cuéntanos qué está preparando tu empresa y exploremos las posibilidades.</p></div>
  </section>

  <section class="section" id="espacios">
    <div class="section-heading"><div><p class="eyebrow">Conoce el recinto</p><h2>El espacio también hace el evento.</h2></div><a class="text-link" href={withBase('/espacios/')}>Explorar los espacios <span aria-hidden="true">↗</span></a></div>
    <div class="space-preview-grid">{spaces.slice(0,3).map((space,index) => <article class="space-preview"><a href={withBase(`/espacios/#${space.id}`)} aria-label={`Conocer espacio ${index + 1}`}><PhotoFrame photo={illustrativePhotos[[1,2,0][index]]} sizes="(min-width: 900px) 32vw, 100vw" caption={false} /></a><div class="space-preview-heading"><h3>Espacio {index + 1}</h3><span aria-hidden="true">↗</span></div><p class="muted small">Nombre, capacidad y características por confirmar.</p></article>)}</div>
  </section>

  <section class="company-feature">
    <div class="company-feature-copy"><p class="eyebrow">El plan empieza con tu equipo</p><h2>Un año de esfuerzo.<br />Una noche para celebrarlo.</h2><p>Comparte la fecha, cuántas personas esperas y qué tipo de celebración tienes en mente. Revisaremos tu solicitud y las opciones disponibles para tu empresa.</p><a class="button secondary" href={withBase('/eventos/')}>Explorar tipos de evento <span aria-hidden="true">↗</span></a></div>
    <PhotoFrame photo={illustrativePhotos[3]} sizes="(min-width: 900px) 45vw, 100vw" caption={false} />
  </section>

  <section class="service-section section"><div><p class="eyebrow">De la idea al encuentro</p><h2>Empecemos por lo que necesitas.</h2><p class="muted">Cada empresa celebra a su manera. Conversemos sobre espacios, montaje y condiciones antes de definir la propuesta.</p><a class="text-link" href={withBase('/contacto/#formulario')}>Conversar con el equipo <span aria-hidden="true">↗</span></a></div><div class="service-list">{serviceReferences.map(service => <article><svg class="service-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19V5h14v14zM5 12h14M12 5v14" /></svg><div><h3>{service.title}</h3><p>{service.description}</p><span class="pending-tag">{service.pending}</span></div></article>)}</div></section>

  <section class="section home-gallery"><div class="section-heading"><div><p class="eyebrow">Ambientes que inspiran</p><h2>Dale una vuelta a la rutina.</h2></div><a class="text-link" href={withBase('/galeria/')}>Explorar la galería <span aria-hidden="true">↗</span></a></div><div class="gallery-preview">{[galleryPhotos[0],galleryPhotos[1] ?? galleryPhotos[0]].filter(Boolean).map(photo => <a href={withBase('/galeria/')} aria-label="Explorar fotografías de referencia"><PhotoFrame photo={photo} /></a>)}</div></section>
  <VisitCta />
</Base>
