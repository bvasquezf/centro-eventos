---
import { withBase } from '../lib/paths';
import Base from '../layouts/Base.astro';
import { eventCategories } from '../content/site';
import { illustrativePhotos, serviceReferences } from '../content/design';
import PhotoFrame from '../components/design/PhotoFrame.astro';
import VisitCta from '../components/design/VisitCta.astro';
---
<Base title="Eventos y servicios"><section class="page-heading"><p class="eyebrow">Motivos para reunirnos</p><h1>Hay mucho que celebrar en equipo.</h1><p class="page-lead">Un año de trabajo, un nuevo desafío o un logro compartido. Cuéntanos qué reúne a tu empresa y revisemos cómo darle forma.</p></section><div class="event-features">{eventCategories.map((event,index) => <article class="event-feature"><PhotoFrame photo={illustrativePhotos[index===0?0:1]} eager={index===0} /><div><p class="eyebrow">{index===0?'Fuera de la rutina':'Personas que conectan'}</p><h2>{event.title}</h2><p>{event.description}</p><p class="muted">{index===0?'Comparte el objetivo del encuentro, la cantidad aproximada de asistentes y los requerimientos de tu equipo.':'Cuéntanos qué busca tu equipo, la fecha tentativa y las necesidades de la jornada.'}</p><a class="text-link" href={withBase('/contacto/#formulario')}>Solicitar una propuesta <span aria-hidden="true">↗</span></a></div></article>)}</div><section class="section"><div class="section-heading"><div><p class="eyebrow">Antes de dar el siguiente paso</p><h2>Hablemos de los detalles.</h2></div><p class="muted section-aside">Las prestaciones disponibles y sus condiciones se confirman al responder tu solicitud.</p></div><div class="service-columns">{serviceReferences.map(service => <article><h3>{service.title}</h3><p>{service.description}</p><span class="pending-tag">{service.pending}</span></article>)}</div></section><VisitCta /></Base>
